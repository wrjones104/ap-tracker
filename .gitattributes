# Generated by scripts/generate_changelog.py, which writes LF explicitly
# (newline='\n') so its --check comparison is byte-exact on every platform.
# Without this, core.autocrlf=true wants CRLF in the working tree on Windows and
# these two files sit permanently "modified" with no actual content change.
android/CHANGELOG.md text eol=lf
backend/CHANGELOG.md text eol=lf
