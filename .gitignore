# --- SECRETS & CONFIGURATION (Most Important) ---
# Python Environment Variables
.env
.env.*
# Firebase Admin SDK (Backend)
service-account-key.json
# Firebase Configs (Android - covering all variants)
**/google-services.json
ag_review/

# --- ANDROID ---
# Standard Android Build folders (Reduces repo size significantly)
build/
.gradle/
app/build/
prod/
android/.kotlin/errors/
# Local configuration file (contains SDK path, often strictly local)
local.properties

# Android Studio & IDE files
*.iml
.idea/
.navigation/
captures/
*.jks
*.keystore
*.p12
*.pem
.vscode

# --- PYTHON / BACKEND ---
# Virtual Environments
.venv/
venv/
env/
# Bytecode and Cache
__pycache__/
*.pyc
.pytest_cache/
# Distribution / Packaging
*.egg-info/
dist/

# SQLite (Dev)
*.db
*.db-shm
*.db-wal
backend/ap_tracker.db
backend/ap_tracker.db-shm
backend/ap_tracker.db-wal
backend/datapackage.json
backend/get_datapackages.py
backend/get_room_status
backend/tracker_data.json

# --- OS JUNK ---
.DS_Store
Thumbs.db

# --- RELEASE ARTIFACTS ---
*.apk
*.aab

# backend/app/data/changelog.json is the hand-authored single source of truth
# for release notes and versions — it is tracked, not generated. The derived
# android/CHANGELOG.md and backend/CHANGELOG.md are produced from it by
# scripts/generate_changelog.py.

# --- BACKEND TESTS ---
# Track the project's backend test suite even if a contributor's global
# gitignore excludes `tests/`. Test artifacts (compiled code, scratch DBs)
# stay ignored.
!backend/tests/
backend/tests/__pycache__/
backend/tests/*.db
backend/tests/*.db-*

# --- CLAUDE CODE ---
# Per-machine permission allowlist, not project configuration. Everything else
# under .claude/ (CLAUDE.md, skills/) is shared and tracked.
.claude/settings.local.json
