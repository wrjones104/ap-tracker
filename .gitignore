# --- SECRETS & CONFIGURATION (Most Important) ---
# Python Environment Variables
.env
.env.*
# Firebase Admin SDK (Backend)
service-account-key.json
# Firebase Configs (Android - covering all variants)
**/google-services.json
ag_review/

# --- ANDROID ---
# Standard Android Build folders (Reduces repo size significantly)
build/
.gradle/
app/build/
prod/
